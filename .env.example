NODE_ENV=development
PORT=4001

# Same PostgreSQL database as Admin (shared source of truth for catalog/orders/etc.)
DATABASE_URL=postgresql://wastro:wastro@localhost:5432/wastro_admin

# Next.js storefront origin (credentials + CORS)
CLIENT_ORIGIN=http://localhost:3000

# Session / CSRF — use a long random secret (min 32 chars). Keep separate from Admin.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=43200000

# HMAC secret for payment provider webhooks (required in real deployments)
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
